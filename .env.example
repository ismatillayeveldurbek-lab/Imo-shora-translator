# Copy to .env and adjust. Never commit .env.

# --- Runtime ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=uzsign
# Change for any shared or production environment.
POSTGRES_PASSWORD=uzsign_dev_password
POSTGRES_DB=uzsign

# --- Backend ---
# Used by local (non-docker) runs; docker compose overrides it to point at the db service.
DATABASE_URL=postgresql+asyncpg://uzsign:uzsign_dev_password@localhost:5432/uzsign
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-not-for-production
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576
MODEL_ARTIFACTS_DIR=../ml/checkpoints
# Empty = speech recognition disabled (shown as "not configured" in the UI).
ASR_PROVIDER=

# --- Frontend (inlined at build time; must never contain secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
